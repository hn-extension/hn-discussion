{
  "manifest_version": 3,
  "name": "Hacker News Discussion Sidebar",
  "version": "1.0",
  "description": "Shows the latest HN submission for the current URL.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://hn.algolia.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle HN Sidebar"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}