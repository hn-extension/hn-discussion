{
  "manifest_version": 3,
  "name": "Hacker News Discussion Sidebar",
  "version": "0.0.1",
  "description": "Shows the latest HN submission for the current URL.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://hn.algolia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle HN Sidebar"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
